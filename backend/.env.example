# PostgreSQL (Render: set DATABASE_URL only; local: use fields below)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=inventario

# Set to true only in local development (use migrations in production)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Application
PORT=3000

# CORS (comma-separated origins, * or CORS_ALLOW_ALL=true for any origin)
# Example Render/Vercel: CORS_ORIGIN=https://tu-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# CORS_ALLOW_ALL=true
